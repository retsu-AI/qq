// Everforest (dark, medium). Palette: github.com/sainnhe/everforest.
//
// Aqua is the accent, orange the brand. grey1 is the palette's comment
// tone and bg2 the elevated surface.
//
// Syntax follows colors/everforest.vim's tree-sitter links: keywords red,
// functions green, types yellow, strings aqua, numbers purple, comments
// grey1, properties blue, brackets fg.
(
    version: 1,
    defs: {
        "fg":     "#d3c6aa",
        "grey1":  "#859289",
        "aqua":   "#83c092",
        "orange": "#e69875",
        "yellow": "#dbbc7f",
        "red":    "#e67e80",
        "green":  "#a7c080",
        "bg2":    "#3d484d",
        "purple": "#d699b6",
        "blue":   "#7fbbb3",
    },
    colors: (
        text:    "fg",
        muted:   "grey1",
        accent:  "aqua",
        brand:   "orange",
        warning: "yellow",
        error:   "red",
        success: "green",
        surface: "bg2",
    ),
    syntax: (
        keyword:     "red",
        function:    "green",
        type:        "yellow",
        string:      "aqua",
        constant:    "purple",
        comment:     "grey1",
        property:    "blue",
        punctuation: "fg",
    ),
)
