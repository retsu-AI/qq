// Dracula. Palette: draculatheme.com/spec.
//
// Purple is the accent, orange the brand, and the spec's opaque selection
// tone is the code surface so it sits one step above the background.
//
// Syntax follows the Dracula specification (draculatheme.com/spec):
// keywords pink, functions green, types and object keys cyan, strings
// yellow, constants purple, comments the comment tone, variables and
// brackets foreground.
(
    version: 1,
    defs: {
        "foreground": "#f8f8f2",
        "comment":    "#6272a4",
        "purple":     "#bd93f9",
        "orange":     "#ffb86c",
        "yellow":     "#f1fa8c",
        "red":        "#ff5555",
        "green":      "#50fa7b",
        "selection":  "#44475a",
        "pink":       "#ff79c6",
        "cyan":       "#8be9fd",
    },
    colors: (
        text:    "foreground",
        muted:   "comment",
        accent:  "purple",
        brand:   "orange",
        warning: "yellow",
        error:   "red",
        success: "green",
        surface: "selection",
    ),
    syntax: (
        keyword:     "pink",
        function:    "green",
        type:        "cyan",
        string:      "yellow",
        constant:    "purple",
        comment:     "comment",
        property:    "cyan",
        punctuation: "foreground",
    ),
)
