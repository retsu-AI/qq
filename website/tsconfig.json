{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Astro's `strict` preset (astro/tsconfigs/strict -> base), inlined. The
  // preset is reached through the package's `exports` wildcard, which some
  // TypeScript-aware runners resolve incorrectly (nubjs/nub#804); these
  // options are what the preset has contained since Astro 5.
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "jsx": "preserve"
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
