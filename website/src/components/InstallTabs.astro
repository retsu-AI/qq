---
import { Tabs, TabItem } from '@astrojs/starlight/components';
import ShellCommand from './ShellCommand.astro';
import { installMethods, site } from '../../site.config.mjs';
---
<div class="install-widget" id="install">
  <Tabs syncKey="install-method">
    {installMethods.map(({ label, command }) => <TabItem label={label}><ShellCommand command={command} prompt={label !== 'Windows'} /></TabItem>)}
  </Tabs>
  <p class="install-caption">No runtime to install. <a href={`${site.github}/releases`}>Or download a binary <span aria-hidden="true">↗</span></a></p>
</div>
