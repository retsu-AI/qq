---
// Extends Starlight ThemeProvider: Ink defaults to dark, while its native selector keeps user choice.
import Default from '@astrojs/starlight/components/ThemeProvider.astro';
---
<script is:inline>
  try {
    if (localStorage.getItem('starlight-theme') === null) localStorage.setItem('starlight-theme', 'dark');
  } catch {}
  document.documentElement.classList.add('bg-background');
</script>
<Default><slot /></Default>
