---
// The right-hand sidebar as `qq` draws it at 100+ columns (goldens
// `sessions-*.txt`): groups NEEDS YOU / WORKING / IDLE / DONE with counts,
// one row per session with the state glyph, children indented under their
// parent, `N new` for unread finishes, and a truncated last line of status
// under a working session. Left of it, the transcript of the focused
// session: a `▌ YOU` prompt and the `related sessions` cell.
import { Icon } from '@astrojs/starlight/components';
import Kbd from './Kbd.astro';
import { href } from '../../site.config.mjs';
---
<section class="landing-section split-section" aria-labelledby="agents">
  <div class="section-copy"><p class="section-eyebrow">KEEP THE WORK IN VIEW</p><h2 id="agents">Many agents, one screen.</h2><p>The sidebar groups sessions by what you should do — <span class="mono">NEEDS YOU</span>, <span class="mono">WORKING</span>, <span class="mono">IDLE</span>, <span class="mono">DONE</span> — with unread counts, not by when you opened them. <Kbd>Ctrl</Kbd>+<Kbd>G</Kbd> jumps to the next one that needs you.</p><p><Kbd>Alt</Kbd>+<Kbd>A</Kbd> / <Kbd>Alt</Kbd>+<Kbd>D</Kbd> approve or deny another session's oldest held call without leaving yours. Sub-agents appear under their parent, bounded by the roster and depth you configure.</p><a class="section-link" href={href('docs/tui/#sessions')}>Work with sessions <Icon name="right-arrow" size="18" /></a></div>
  <div class="tui tui-sessions" role="img" aria-label="The QQ session sidebar: NEEDS YOU with one approval, WORKING with two sessions, IDLE with one, DONE with one">
    <div class="tui-top"><span class="tui-brand">qq</span><span class="tui-crumb">my-project <span class="tui-sep">›</span> plan the release</span><span class="tui-right">anthropic/claude-sonnet-5<span>$0.11</span></span></div>
    <div class="tui-split">
      <div class="tui-body">
        <div class="tui-msg you"><span class="rail">▌</span><span class="who">YOU</span></div>
        <div class="tui-msg you"><span class="rail">▌</span><span class="text">Plan the 0.2 release and split the work.</span></div>
        <div class="tui-blank" />
        <div class="tui-msg qq"><span class="rail"> </span><span class="who">QQ</span></div>
        <div class="tui-msg qq"><span class="rail"> </span><span class="text">Checklist drafted: twelve items, three need code.</span></div>
        <div class="tui-msg qq"><span class="rail"> </span><span class="text">Starting two helpers: one writes the regression tests, one surveys the callers of the changed API.</span></div>
        <div class="tui-blank" />
        <div class="tui-related"><span class="label">related sessions</span></div>
        <div class="tui-related"><span class="arrow">↳</span><span class="g wait">◇</span><span>Deploy helper</span></div>
        <div class="tui-related"><span class="arrow">↳</span><span class="g run">◐</span><span>Write tests</span></div>
      </div>
      <aside class="tui-sidebar">
        <div class="grp wait">NEEDS YOU <span>1</span></div>
        <div class="row"><span class="g done">●</span><span class="name">Plan the release</span></div>
        <div class="row child"><span class="g wait">◇</span><span class="name">Deploy helper</span></div>
        <div class="row child status"><span class="g wait">◇</span><span>approve run</span></div>
        <div class="grp">WORKING <span>2</span></div>
        <div class="row"><span class="g run">◐</span><span class="name">Write tests</span><span class="new">1 new</span></div>
        <div class="row status"><span>Adding a regressio…</span></div>
        <div class="row"><span class="g run">◐</span><span class="name">Survey callers</span></div>
        <div class="row status"><span>Found twelve call …</span></div>
        <div class="grp">IDLE <span>1</span></div>
        <div class="row"><span class="g idle">○</span><span class="name">Scratch</span></div>
        <div class="grp">DONE <span>1</span></div>
        <div class="row"><span class="g done">●</span><span class="name">Fix edge cases</span></div>
      </aside>
    </div>
    <div class="tui-rule"><span class="spin" aria-hidden="true"></span><span class="activity">generating</span><span class="meta">12s  ttft 0.6s  turn 2</span><span class="hr" aria-hidden="true"></span><span class="hints"><span><b>?</b> help</span><span><b>^K</b> commands</span><span><b>^O</b> detail</span></span></div>
    <div class="tui-composer"><span class="prompt">›</span><span class="placeholder">Ask QQ...</span></div>
  </div>
</section>
