#!/usr/bin/env sh
# Enabled with `git config core.hooksPath .githooks` (see docs/runbooks/testing.md).
# Runs the affected-only gate; the merge queue runs `cargo xtask check --full`.
# Skip once with `git push --no-verify` only when the push is docs-only WIP.
set -eu
head=$(git rev-parse HEAD)
updates=0
while read -r local_ref local_oid remote_ref remote_oid; do
    # Deleting a remote ref introduces no unchecked commit.
    case "$local_oid" in *[!0]*) ;; *) continue ;; esac
    tip=$(git rev-parse "$local_oid^{commit}") || exit 1
    if [ "$tip" != "$head" ]; then
        echo "pre-push: refusing unchecked tip $local_ref; check it out and push HEAD separately" >&2
        exit 1
    fi
    updates=$((updates + 1))
done
[ "$updates" -gt 0 ] || exit 0

if [ -n "$(git status --porcelain --untracked-files=all)" ]; then
    echo 'pre-push: commit or stash staged, unstaged and untracked changes before validating the pushed tree' >&2
    exit 1
fi
exec cargo xtask check --profile quick
