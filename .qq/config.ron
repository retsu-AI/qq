(
    policy: (
        allow_tools: [
            "edit_file",
        ],
        allow_shell_prefixes: [
            "git status --short && git diff --stat",
            "cargo fmt --all && cargo check --workspace",
            "cargo fmt --all -- --check && cargo check --workspace",
        ],
    ),
    version: 1,
    model: "xai/grok-4.6",
    reviewer_model: "openai-codex/gpt-5.6-luna",
    providers: {
        "bedrock": AmazonBedrock(
            region: "us-east-1",
            auth: ApiKey(Stored("bedrock/default")),
        ),
        "bedrock-mantle": AmazonBedrockMantle(
            region: "us-east-1",
            api: AnthropicMessages,
            auth: ApiKey(Stored("bedrock-mantle/default")),
        ),
        // LiteLLM endpoint used by local QQ runs and Terminal-Bench.
        // Replace the two REPLACE_WITH_* values with your gateway details.
        "litellm": LiteLlm(
            connection: (
                base_url: "https://litellm.example.invalid/v1",
                api: OpenAiChatCompletions,
                // Local QQ resolves this key from its credential store. The
                // Harbor runner must inject an environment-backed override.
                auth: ApiKey(Stored("litellm/default")),
            )
        ),
    },
    mcp: {
        "executor": Http(
            url: "https://executor.sh/lg2m/mcp",
            // Executor Cloud accepts user-level API keys as bearer tokens.
            bearer: Stored("executor/lg2m"),
            allow: [
                "execute",
                "skills",
                "resume",
            ],
            eager: true,
        ),
    },
)
