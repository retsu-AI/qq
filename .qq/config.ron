(
    policy: (
        allow_tools: [
            "exec",
            "edit_file",
        ],
        allow_shell_prefixes: [
            "git status --short && git diff --stat",
            "cargo fmt --all && cargo check --workspace",
            "cargo fmt --all -- --check && cargo check --workspace",
        ],
    ),
    version: 1,
    model: "xai/grok-4.6",
    // Anything referencing a `Stored(...)` credential (providers, MCP
    // servers, reviewer/worker models) is personal to one machine and belongs
    // in a gitignored `.qq/config.d/*-local.ron` fragment, not here. Built-in
    // providers need no declaration: `qq auth login PROVIDER` or the
    // provider's API-key variable is enough. See docs/guide/configuration.md.
)
