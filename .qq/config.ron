(
    policy: (
        allow_tools: [
            "exec",
            "edit_file",
        ],
        allow_shell_prefixes: [
            "git status --short && git diff --stat",
            "cargo fmt --all && cargo check --workspace",
            "cargo fmt --all -- --check && cargo check --workspace",
        ],
    ),
    version: 1,
    model: "xai/grok-4.6",
    // Providers, reviewer/worker models, and MCP servers that reference a
    // `Stored(...)` credential are personal: the name resolves against each
    // developer's own credential store, so a clone without that entry fails
    // with "credential ... is not registered". Declare them in a gitignored
    // `.qq/config.d/*-local.ron` fragment. Built-in providers (openai,
    // anthropic, google, xai, openai-codex, bedrock) need no declaration here;
    // authenticate with `qq auth login PROVIDER` or the provider's API-key
    // environment variable.
)
