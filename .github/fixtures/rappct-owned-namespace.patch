diff --git a/src/object_directory.rs b/src/object_directory.rs
new file mode 100644
index 0000000..2445450
--- /dev/null
+++ b/src/object_directory.rs
@@ -0,0 +1,96 @@
+//! Access to one profile-owned AppContainer named-object directory.
+#[cfg(windows)]
+use crate::AppContainerProfile;
+#[cfg(windows)]
+use crate::ffi::handles::Handle;
+use crate::{AcError, Result};
+#[cfg(windows)]
+use windows::Wdk::{Foundation::OBJECT_ATTRIBUTES, Storage::FileSystem::NtOpenDirectoryObject};
+#[cfg(windows)]
+use windows::Win32::Foundation::{HANDLE, OBJECT_ATTRIBUTE_FLAGS, UNICODE_STRING};
+#[cfg(windows)]
+use windows::core::PWSTR;
+
+#[cfg(windows)]
+pub(crate) fn grant(profile: &AppContainerProfile, sid: &str) -> Result<()> {
+    use windows::Win32::System::{
+        RemoteDesktop::ProcessIdToSessionId, Threading::GetCurrentProcessId,
+    };
+    let relative = profile.named_object_path()?;
+    let mut session = 0;
+    // SAFETY: Current PID is valid; session points to one initialized u32.
+    unsafe { ProcessIdToSessionId(GetCurrentProcessId(), &mut session) }
+        .map_err(|error| AcError::Win32(format!("ProcessIdToSessionId: {error}")))?;
+    let path = namespace_path(&relative, profile.sid.as_string(), session)?;
+    let directory = open_directory(&path)?;
+    crate::acl::grant_kernel_directory_creation(directory.as_win32(), sid)
+}
+
+fn namespace_path(reported: &str, sid: &str, session: u32) -> Result<String> {
+    let relative = format!("AppContainerNamedObjects\\{sid}");
+    let absolute = format!("\\Sessions\\{session}\\{relative}");
+    if reported != relative && reported != absolute {
+        return Err(AcError::Win32(format!(
+            "unexpected AppContainer namespace path: {reported}"
+        )));
+    }
+    Ok(absolute)
+}
+
+#[cfg(windows)]
+fn open_directory(path: &str) -> Result<Handle> {
+    let mut wide = path.encode_utf16().collect::<Vec<_>>();
+    let length = wide
+        .len()
+        .checked_mul(2)
+        .and_then(|n| u16::try_from(n).ok())
+        .filter(|_| !wide.contains(&0))
+        .ok_or_else(|| AcError::Win32("invalid AppContainer namespace path".into()))?;
+    let name = UNICODE_STRING {
+        Length: length,
+        MaximumLength: length,
+        Buffer: PWSTR(wide.as_mut_ptr()),
+    };
+    let attrs = OBJECT_ATTRIBUTES {
+        Length: std::mem::size_of::<OBJECT_ATTRIBUTES>() as u32,
+        ObjectName: &name,
+        Attributes: OBJECT_ATTRIBUTE_FLAGS(0x40),
+        ..Default::default()
+    };
+    let mut handle = HANDLE::default();
+    // SAFETY: Unicode buffer and object attributes remain live through this
+    // synchronous call; the output handle is guarded immediately on success.
+    let status =
+        unsafe { NtOpenDirectoryObject(&mut handle, 0x0002_0000 | 0x0004_0000 | 0x3, &attrs) };
+    if status.is_err() {
+        return Err(AcError::Win32(format!(
+            "NtOpenDirectoryObject(AppContainer {path}): {status:?}"
+        )));
+    }
+    // SAFETY: Successful NtOpenDirectoryObject returned a uniquely owned kernel
+    // handle; Handle uses CloseHandle exactly once on every return path.
+    unsafe { Handle::from_raw(handle.0) }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::namespace_path;
+    #[test]
+    fn namespace_is_exact_profile_and_current_session() {
+        let sid = "S-1-15-2-1-2-3";
+        let expected = format!("\\Sessions\\3\\AppContainerNamedObjects\\{sid}");
+        assert_eq!(
+            namespace_path(&format!("AppContainerNamedObjects\\{sid}"), sid, 3).unwrap(),
+            expected
+        );
+        assert_eq!(namespace_path(&expected, sid, 3).unwrap(), expected);
+        for bad in [
+            format!("AppContainerNamedObjects\\{sid}0"),
+            format!("\\Sessions\\4\\AppContainerNamedObjects\\{sid}"),
+            format!("AppContainerNamedObjects\\..\\{sid}"),
+            "\\BaseNamedObjects".into(),
+        ] {
+            assert!(namespace_path(&bad, sid, 3).is_err(), "{bad}");
+        }
+    }
+}
