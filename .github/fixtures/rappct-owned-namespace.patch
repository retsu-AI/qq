+/// Preserve the directory ACL, granting only query/traverse/object creation.
+pub(crate) fn grant_kernel_directory_creation(handle: HANDLE, sid_sddl: &str) -> Result<()> {
+    use windows::Win32::Security::Authorization::SE_KERNEL_OBJECT;
+    let trustee = SidTrustee::from_sddl(sid_sddl)?;
+    let mut descriptor = PSECURITY_DESCRIPTOR::default();
+    let mut old_dacl = std::ptr::null_mut();
+    // SAFETY: The caller owns a live directory handle with READ_CONTROL; output
+    // pointers are valid and the returned allocation is immediately guarded.
+    let status = unsafe {
+        GetSecurityInfo(
+            handle,
+            SE_KERNEL_OBJECT,
+            DACL_SECURITY_INFORMATION,
+            None,
+            None,
+            Some(&mut old_dacl),
+            None,
+            Some(&mut descriptor),
+        )
+    };
+    win32_status(status.0, "GetSecurityInfo(AppContainer directory)")?;
+    let old = SecurityDescriptorDacl::new(descriptor, old_dacl);
+    if old.old_dacl.is_null() {
+        return Err(AcError::Win32(
+            "AppContainer directory has a null DACL".into(),
+        ));
+    }
+    let new_dacl = merge_dacl(
+        old.old_dacl,
+        0xF,
+        AceInheritance::NONE,
+        trustee.as_trustee(),
+        "SetEntriesInAclW(AppContainer directory)",
+    )?;
+    // SAFETY: Handle remains owned and both DACL allocations stay live through
+    // the synchronous setter. Only this directory's DACL is changed.
+    let status = unsafe {
+        SetSecurityInfo(
+            handle,
+            SE_KERNEL_OBJECT,
+            DACL_SECURITY_INFORMATION,
+            None,
+            None,
+            Some(new_dacl.as_ptr()),
+            None,
+        )
+    };
+    win32_status(status.0, "SetSecurityInfo(AppContainer directory)")
+}
