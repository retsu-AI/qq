{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "platforms": ["windows", "macOS", "linux"],
  "description": "Main window: core events, folder picker, opening links in the system browser, and revealing project files in Explorer.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    "opener:allow-reveal-item-in-dir"
  ]
}
