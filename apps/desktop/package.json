{
  "name": "qq-desktop",
  "private": true,
  "version": "0.1.6",
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:version": "node scripts/check-version.mjs",
    "tauri": "tauri",
    "engine": "node scripts/build-engine.mjs",
    "bundle": "pnpm engine && tauri build --config src-tauri/tauri.bundle.conf.json"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.21",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
